# Copy to .env and adjust. All settings are optional in local development.
#
# No laptop may hold staging or production credentials. This file, and every backend/.env made from it,
# points at the local MongoDB from docker-compose.yml (make db-up). Staging and production settings
# live only in the hosting dashboard. A backend/.env that still points at a hosted cluster must list
# that cluster in NEARSHOP_PROTECTED_HOSTS (below) until it is moved off the laptop.
#
# development | test | staging | production | demo. Any other value stops the API, seed and tools.
NEARSHOP_ENVIRONMENT=development
# Required outside development. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
NEARSHOP_SECRET_KEY=change-me
# MongoDB: the local single-node replica set (transactions need a replica set). make db-up starts it.
NEARSHOP_MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
NEARSHOP_MONGODB_DB=nearshop
# Environment guard. The seed (which resets the database) refuses unless the environment is development,
# test or demo (development and test: a local MongoDB only; a hosted demo cluster needs demo), the
# database is not NEARSHOP_PRODUCTION_MONGODB_DB, no URI host is in NEARSHOP_PROTECTED_HOSTS and
# --confirm-db repeats the database name (make seed passes it for the local database).
# NEARSHOP_PROTECTED_HOSTS: the staging and production clusters, comma-separated; a listed name also
# covers its subdomains. For MongoDB Atlas list the project domain, for example abcd1.mongodb.net: it
# covers both the SRV name (cluster0.abcd1.mongodb.net) and the member hosts of the standard mongodb://
# string (ac-xyz-shard-00-00.abcd1.mongodb.net). A listed Atlas cluster name also covers its project domain.
NEARSHOP_PRODUCTION_MONGODB_DB=nearshop_prod
NEARSHOP_PROTECTED_HOSTS=
# Tests read only NEARSHOP_TEST_MONGODB_URI (make test sets mongodb://127.0.0.1:27017/?directConnection=true).
# It must be a localhost, 127.0.0.1 or mongo (CI) server and differ from NEARSHOP_MONGODB_URI.
# City to seed (ballari, mysuru, hubballi, vijayawada, coimbatore, nashik)
NEARSHOP_SEED_CITY=ballari
# Password for the seeded demo accounts. Required by the seed, which refuses anything shorter than
# 16 characters. Generate a random value with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# Put it only in your own .env and share it privately; never commit it.
NEARSHOP_DEMO_PASSWORD=
# Admin second factor (P2.4). The key that encrypts each admin's TOTP secret (a Fernet key; several keys
# separated by commas decrypt, the first encrypts, so the key can be rotated). Without it every admin sign-in
# answers 503 totp_unavailable and database.admin_tasks create-admin refuses to run. The API and create-admin
# must use the same value. Generate one with:
#   uv run python -c "from app.core.security import generate_totp_key as g; print(g())"
# Staging and production each set their own key in the Render dashboard only, never this file's value.
# Admins are enrolled only by create-admin. The seeded demo admin has no second factor, so it cannot sign
# in (totp_not_enrolled), and the demo-account picker's admin entry fails too. To use the admin console
# locally, set this key and run: uv run python -m database.admin_tasks create-admin --name "Your Name"
# --email you@example.com (it prints the password, the authenticator URI and recovery codes once).
NEARSHOP_TOTP_KEY=
# fastembed (all-MiniLM-L6-v2, downloaded once) or tfidf (fully offline fallback)
NEARSHOP_EMBEDDING_PROVIDER=fastembed
NEARSHOP_COOKIE_SECURE=false
# Photos. local (the default): files under NEARSHOP_MEDIA_DIR (default backend/media), served by the API at
# /media and proxied by the Next.js dev server. Keep local on a laptop and in tests (they use an in-memory
# fake, never a bucket). Staging and production set s3 in the Render dashboard, each with its own
# Cloudflare R2 bucket and token; no laptop holds those keys. With s3, five settings are required: the
# endpoint, bucket, access key id, secret and public base URL. The region defaults to auto (what R2 uses).
NEARSHOP_MEDIA_BACKEND=local
# NEARSHOP_MEDIA_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# NEARSHOP_MEDIA_S3_BUCKET=
# NEARSHOP_MEDIA_S3_ACCESS_KEY_ID=
# NEARSHOP_MEDIA_S3_SECRET_ACCESS_KEY=
# NEARSHOP_MEDIA_S3_REGION=auto
# The bucket's public custom domain. When set, image URLs point there instead of /media. It must be
# https:// in staging, production and demo; http:// is accepted only in development and test.
# NEARSHOP_MEDIA_PUBLIC_BASE_URL=
# Off-site backups (database/backup.py and database/restore.py; docs/runbooks/restore.md). off (the default):
# both tools refuse to run. On a laptop use make backup and make restore, which always use the local database
# and a local directory (BACKUP_DIR in the Makefile) whatever this file says. Staging and production set s3 in
# their Render backup cron jobs only, each with its own private backup bucket and token (never a photo
# bucket); no laptop holds those keys. Sets go under NEARSHOP_BACKUP_PREFIX (default: the environment name).
# Retention: the newest set of each of the last 30 days and the first of each of the last 12 months.
NEARSHOP_BACKUP_BACKEND=off
# local: the directory that holds the sets.
# NEARSHOP_BACKUP_DIR=
# NEARSHOP_BACKUP_PREFIX=
# NEARSHOP_BACKUP_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# NEARSHOP_BACKUP_S3_BUCKET=
# NEARSHOP_BACKUP_S3_ACCESS_KEY_ID=
# NEARSHOP_BACKUP_S3_SECRET_ACCESS_KEY=
# NEARSHOP_BACKUP_S3_REGION=auto
# NEARSHOP_BACKUP_KEEP_DAILY=30
# NEARSHOP_BACKUP_KEEP_MONTHLY=12
# Deployed environments (render.yaml): staging (NEARSHOP_ENVIRONMENT=staging, branch main) and production
# (branch release) each get their own NEARSHOP_MONGODB_URI, NEARSHOP_SECRET_KEY and NEARSHOP_PROTECTED_HOSTS
# in the Render dashboard only. Render sets RENDER_GIT_COMMIT on each deploy and /api/health reports it;
# nothing to set here.
# The smoke test (make smoke, backend/scripts/smoke.py) reads only the process environment, never this file.
# Its full mode signs in with the staging smoke account from NEARSHOP_SMOKE_EMAIL and NEARSHOP_SMOKE_PASSWORD,
# which live only in GitHub Actions secrets; NEARSHOP_SMOKE_VERCEL_BYPASS is optional. Do not put them here.
# Observability (app/core/observability.py). Error tracking (Sentry) is on only when NEARSHOP_SENTRY_DSN is
# set; leave it blank on a laptop (tests always blank it). Staging and production set it in the Render
# dashboard only. Events carry NEARSHOP_ENVIRONMENT and the release: NEARSHOP_RELEASE, else Render's
# RENDER_GIT_COMMIT. Trace sample rates are 0 to 1 (search requests use the second one).
NEARSHOP_SENTRY_DSN=
# NEARSHOP_SENTRY_TRACES_SAMPLE_RATE=0.1
# NEARSHOP_SENTRY_SEARCH_TRACES_SAMPLE_RATE=0.25
# NEARSHOP_RELEASE=
# Request id headers to trust from the edge, first found wins (otherwise a new id is made).
# NEARSHOP_REQUEST_ID_HEADERS=x-vercel-id,x-request-id
# The frontend's error tracking is set in the Vercel project settings, read at build time: NEXT_PUBLIC_SENTRY_DSN
# (on only when set; environment and release come from Vercel's own variables), and optionally SENTRY_ORG,
# SENTRY_PROJECT and SENTRY_AUTH_TOKEN to upload source maps (frontend/next.config.ts).
# Storage budget (P2.2): the Atlas tier's storage limit in MB, for the admin storage card and the daily
# snapshot's 70% and 85% warnings. 512 for M0 (a laptop, staging, demo); production sets 5120 (Flex) in render.yaml.
# NEARSHOP_STORAGE_LIMIT_MB=512
